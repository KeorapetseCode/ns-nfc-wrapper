<FlexboxLayout  xmlns="http://schemas.nativescript.org/tns.xsd"
                xmlns:btn="components/navigation-buttons/navigation-button"
                class="navigation-bar">
  
  <Repeater items="{{ navItems }}">
    <Repeater.itemTemplate>
      <btn:btn  icon="{{ icon }}" 
                title="{{ title }}"
                buttonName="{{ buttonName }}"
                tap="onNavigationTap" />
    </Repeater.itemTemplate>
  </Repeater>

</FlexboxLayout>